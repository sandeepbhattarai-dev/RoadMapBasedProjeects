@model User;

<div class="container">
  <form action="Login" method="post">
    <div>
      <label class="form-label" asp-for="UserName"></label>
      <input asp-for ="UserName"/>
    </div>
    <div>
      <label class="form-label" asp-for="Password"></label>
      <input asp-for ="Password"/>
    </div>
  </form>
</div>