@model List<Product>


<div class="container py-4">
  <div class="row g-4">
    @foreach (var item in Model)
    {
      <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        <div class="card product-card h-100 border-0 shadow-sm">
          <div class="product-image-wrapper">
            <img src="@item.Link"
                 class="card-img-top product-image"
                 alt="@item.Name"
                 onerror="this.src='https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRC5haONrqK-DU7tXuhzAgosiFhvVdI7xWn9QtMNuhHlA&s=10';" />
          </div>

          <div class="card-body d-flex flex-column">
            <span class="badge bg-light text-dark border mb-2 align-self-start">
              @item.Type
            </span>

            <h5 class="card-title product-title">@item.Name</h5>

            <p class="card-text text-muted small product-description">
              @item.Description
            </p>

            <h4 class="text-success fw-bold mt-auto mb-3">
              ₹@item.Price.ToString("N2")
            </h4>

            <div class="d-flex gap-2">
              <a asp-action="Edit" asp-route-id="@item.Id"
                 class="btn btn-outline-primary flex-fill">
                Edit
              </a>

              <a asp-action="Remove" asp-route-id="@item.Id"
                 class="btn btn-danger flex-fill">
                Remove
              </a>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
</div>