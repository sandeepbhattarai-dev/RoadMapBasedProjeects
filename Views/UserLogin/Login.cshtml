@model RoadMapBasedProjects.Models.User; 

<div class="auth-card">

  <p class="eyebrow">Please enter your details</p>
  <h1>Welcome back</h1>

  <form novalidate>

    <!-- Email -->
    <div class="mb-3">
      <input type="email"
             class="form-control form-control-pill"
             placeholder="Email adress"
             autocomplete="email" />
    </div>

    <!-- Password -->
    <div class="mb-3">
      <input type="password"
             class="form-control form-control-pill"
             placeholder="Password"
             autocomplete="current-password" />
    </div>

    <!-- Remember + Forgot password -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="rememberMe" />
        <label class="form-check-label" for="rememberMe" />
          Remember
      </div>
      <a href="#" class="forgot-link">Forgot password</a>
    </div>

    <!-- Sign up button -->
    <button type="submit" class="btn btn-primary w-100 mb-3">
      Sign up
    </button>

    <!-- Google sign in -->
    <button type="button" class="btn w-100 mb-3 text-light btn-info btn-outline-primary">
      <i class="bi bi-google me-2"></i>
      <span class="text-light">Sign in with Google</span>
    </button>

    <!-- Bottom text -->
    <p class="text-center bottom-text mb-0 text-light">
      Don't have an account? <a asp-controller="UserLogin" asp-action="SignUp">Sign up</a>
    </p>

  </form>

</div>