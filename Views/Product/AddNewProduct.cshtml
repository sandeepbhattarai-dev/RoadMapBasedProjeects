@model ProductViewModel

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
          <h3 class="fw-bold mb-1">Add Product</h3>
          <p class="text-muted mb-4">Enter the product details below.</p>

          <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
              <label asp-for="Name" class="form-label fw-semibold"></label>
              <input asp-for="Name"
                     class="form-control"
                     placeholder="e.g. Wireless Headphones" />
              <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
              <label asp-for="Price" class="form-label fw-semibold"></label>
              <div class="input-group">
                <span class="input-group-text">₹</span>
                <input asp-for="Price"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       placeholder="0.00" />
              </div>
              <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
              <label asp-for="Type" class="form-label fw-semibold"></label>
              <select asp-for="Type" class="form-select">
                <option value="">Select a category</option>
                <option value="Electronics">Electronics</option>
                <option value="Clothing">Clothing</option>
                <option value="Home">Home</option>
                <option value="Books">Books</option>
                <option value="Sports">Sports</option>
              </select>
              <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="mb-3">
              <label asp-for="Link" class="form-label fw-semibold">
                Product Image URL
              </label>
              <input asp-for="Link"
                     type="url"
                     class="form-control"
                     placeholder="https://example.com/product-image.jpg" />
              <span asp-validation-for="Link" class="text-danger"></span>
            </div>

            <div class="mb-4">
              <label asp-for="Description" class="form-label fw-semibold"></label>
              <textarea asp-for="Description"
                        class="form-control"
                        rows="4"
                        placeholder="Write a short product description..."></textarea>
              <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
              <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                Cancel
              </a>
              <button type="submit" class="btn btn-primary flex-fill">
                Save Product
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}