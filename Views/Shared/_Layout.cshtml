<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>@ViewData["Title"] - MyWorkDiary</title>

  <!-- Bootstrap 3 -->
  <link rel="stylesheet"
        href="~/lib/bootstrap/css/bootstrap.min.css" />
  <link rel="stylesheet" src="~/css/site.css"/>
  @RenderSection("Styles", required: false)
</head>

<body>

  <!-- =========================
         HEADER / NAVIGATION
         ========================= -->

  <nav class="navbar navbar-custom navbar-fixed-top">
    <div class="container">

      <!-- Brand + Mobile Toggle -->
      <div class="navbar-header">

        <button type="button"
                class="navbar-toggle collapsed"
                data-toggle="collapse"
                data-target="#main-navigation">

          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>

        </button>

        <a class="navbar-brand"
           asp-controller="Home"
           asp-action="Index">
          MyWorkDiary
        </a>

      </div>

      <!-- Navigation Menu -->
      <div class="collapse navbar-collapse" id="main-navigation">

        <ul class="nav navbar-nav">

          <li>
            <a asp-controller="Home"
               asp-action="Index">
              Home
            </a>
          </li>

          @* <li>
            <a asp-controller="Diary"
               asp-action="Index">
              My Diary
            </a>
          </li> *@

        </ul>

        <!-- Right Side -->
        @* <ul class="nav navbar-nav navbar-right">

          <li>
            <a asp-controller="Account"
               asp-action="Login">
              Login
            </a>
          </li>

        </ul> *@

      </div>

    </div>
  </nav>


  <!-- =========================
         MAIN CONTENT
         ========================= -->

  <main class="main-content">
    <div class="container">

      @RenderBody()

    </div>
  </main>


  <!-- =========================
         FOOTER
         ========================= -->

  <footer class="site-footer">

    <div class="container">

      <div class="row">

        <!-- About -->
        <div class="col-sm-5 footer-section">

          <h4>MyWorkDiary</h4>

          <p>
            A simple and private space to record your
            thoughts, experiences, and daily work.
          </p>

        </div>


        <!-- Quick Links -->
        <div class="col-sm-3 col-sm-offset-1 footer-section">

          <h4>Quick Links</h4>

          <ul>
            <li>
              <a asp-controller="Home"
                 asp-action="Index">
                Home
              </a>
            </li>

            <li>
              <a asp-controller="Diary"
                 asp-action="Index">
                My Diary
              </a>
            </li>

            <li>
              <a asp-controller="Account"
                 asp-action="Login">
                Login
              </a>
            </li>
          </ul>

        </div>


        <!-- Information -->
        <div class="col-sm-3 footer-section">

          <h4>Information</h4>

          <ul>
            <li>
              <a href="#">About</a>
            </li>

            <li>
              <a href="#">Privacy</a>
            </li>

            <li>
              <a href="#">Contact</a>
            </li>
          </ul>

        </div>

      </div>


      <!-- Footer Bottom -->
      <div class="row">

        <div class="col-sm-12">

          <div class="footer-bottom text-center">

            <p>
              &copy; @DateTime.Now.Year MyWorkDiary.
              All rights reserved.
            </p>

          </div>

        </div>

      </div>

    </div>

  </footer>


  <!-- jQuery -->
  <script src="~/lib/jquery/jquery.min.js"></script>

  <!-- Bootstrap 3 JavaScript -->
  <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>

  @await RenderSectionAsync("Scripts", required: false)

</body>
</html>