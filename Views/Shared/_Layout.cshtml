<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - MyWorkDiary</title>
  <link rel="stylesheet" href="~/css/site.css" />
  <!-- Bootstrap 3 -->
  <link rel="stylesheet"
        href="~/lib/bootstrap/css/bootstrap.min.css" />
</head>
<body>
  <div class="container-fluid">
    <nav>
      <ul class="carousel-">
        <li>week-4</li>
        <li>Home</li>
        <li asp-for="Account" asp-action="Login"><a>Login</a></li>
      </ul>
    </nav>
  </div>
  


  <div class="container-fluid text-light body-height background-image">
    @RenderBody()
  </div>

  <nav class="container-fluid bg-dark-subtle">
    <p class="text-center w-100 h3">This is a footer</p>
    
  </nav>
  <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
  <script src="~/lib/jquery/jquery.min.js"></script>
</body>
</html>