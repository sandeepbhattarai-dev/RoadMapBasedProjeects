<div class="container d-flex bg-dark-subtle justify-content-evenly">
  <div class="col-3 bg-dark p-4 d-flex flex-column justify-content-center">
    <p class="text-center">Already a User?</p>
    <a class="btn btn-info w-25 text-danger fw-bold w-75" asp-controller="UserLogin" asp-action="Login">Login</a>
  </div>
  <div class="col-3 bg-dark p-4 d-flex flex-column justify-content-center">
    <p class="text-center">New Here?</p>
    <a class="btn btn-success w-25 text-danger fw-bold w-75" asp-controller="UserLogin" asp-action="SignUp">Sign Up</a>
  </div>
</div>